# Copy to apps/agent/.env and fill in. Never commit .env.

# LLM (pick one provider: anthropic | openrouter | openai)
# Leave LLM_PROVIDER empty to pick whichever key below is set.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider's defaults:
#   anthropic:  claude-sonnet-5-5 / claude-haiku-5-5
#   openrouter: anthropic/claude-sonnet-5.5 / anthropic/claude-haiku-5.5
AGENT_MODEL=
DETECTOR_MODEL=
# auto = use the LLM judge when a key is set; off = rules only
DETECTOR_LLM=auto

# Trick detector thresholds
RISK_BLOCK_AT=0.7
RISK_REVIEW_AT=0.4

# Mandate API (Member 2). MOCK_API=1 uses the built-in mock until apps/api is ready.
MOCK_API=1
MANDATE_API_URL=http://localhost:4000
MANDATE_ID=mdt_demo
KNOWN_MERCHANTS=demo-store

# apps/agent HTTP server
AGENT_PORT=4100
APPROVAL_TIMEOUT_MS=120000
STORE_BASE_URL=https://mandate-demo.store
