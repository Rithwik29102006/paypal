# Copy to apps/agent/.env and fill in. Never commit .env.

# LLM (pick one provider)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
DETECTOR_MODEL=claude-haiku-5-5
# auto = use the LLM judge when a key is set; off = rules only
DETECTOR_LLM=auto

# Trick detector thresholds
RISK_BLOCK_AT=0.7
RISK_REVIEW_AT=0.4

# Mandate API (Member 2). MOCK_API=1 uses the built-in mock until apps/api is ready.
MOCK_API=1
MANDATE_API_URL=http://localhost:4000
MANDATE_ID=mdt_demo
KNOWN_MERCHANTS=demo-store

# apps/agent HTTP server
AGENT_PORT=4100
APPROVAL_TIMEOUT_MS=120000
STORE_BASE_URL=https://mandate-demo.store
