{
  "name": "@mandate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "tamper": "tsx src/tamper.ts",
    "replay:dispute": "tsx scripts/replay-dispute.ts",
    "import:dispute": "tsx scripts/import-dispute.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@mandate/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pdfkit": "^0.20.2",
    "prisma": "6.19.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  }
}
