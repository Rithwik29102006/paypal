{
  "name": "mandate",
  "private": true,
  "description": "Mandate: a permission slip for AI agents that spend money. PayPal AI Hackathon.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "pnpm --filter @mandate/api dev",
    "web": "pnpm --filter @mandate/web dev",
    "web:build": "pnpm --filter @mandate/web build",
    "agent": "pnpm --filter @mandate/agent dev",
    "agent:server": "pnpm --filter @mandate/agent run server",
    "mcp": "pnpm --filter @mandate/agent mcp",
    "redteam": "pnpm --filter @mandate/agent redteam",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm --filter @mandate/agent demo",
    "db:migrate": "pnpm --filter @mandate/api db:migrate",
    "seed": "pnpm --filter @mandate/api seed",
    "tamper": "pnpm --filter @mandate/api tamper"
  }
}
